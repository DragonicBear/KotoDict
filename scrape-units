// scrape-units.js
// Run via GitHub Actions to regenerate units.js from GameWith.
// Requires: node-fetch, cheerio
// Usage: node scrape-units.js

import fetch from ‘node-fetch’;
import * as cheerio from ‘cheerio’;
import fs from ‘fs’;

const URL = ‘https://gamewith.jp/kotodaman/article/show/99665’;
const OUT  = ‘units.js’;

// ─── helpers ────────────────────────────────────────────────────────────────

/** Normalize a kana string: katakana → hiragana, strip spaces/newlines */
function normalizeKana(str) {
return str
.replace(/[\u30A1-\u30F6]/g, ch =>
String.fromCharCode(ch.charCodeAt(0) - 0x60))   // katakana → hiragana
.replace(/\s+/g, ‘’)
.trim();
}

/** Keep only hiragana characters */
function onlyHiragana(str) {
return […str].filter(ch => ch >= ‘\u3041’ && ch <= ‘\u3096’).join(’’);
}

// ─── main ───────────────────────────────────────────────────────────────────

async function main() {
console.log(`Fetching ${URL} …`);

const res = await fetch(URL, {
headers: {
‘User-Agent’:
‘Mozilla/5.0 (compatible; KotodamanScraper/1.0; +https://github.com)’,
‘Accept-Language’: ‘ja,en;q=0.9’,
},
});

if (!res.ok) {
throw new Error(`HTTP ${res.status} ${res.statusText}`);
}

const html = await res.text();
const $    = cheerio.load(html);

const units = [];
const seen  = new Set();

// GameWith lays out unit data in tables; each row has the unit name
// and a column of kana letters the unit covers.
// Strategy: walk every <tr>, grab the first non-empty text cell as the
// unit name and collect any cells that contain only kana as the letters.
$(‘table tr’).each((_, row) => {
const cells = $(row).find(‘td, th’);
if (cells.length < 2) return;

```
const nameCand = $(cells[0]).text().trim();
if (!nameCand || nameCand.length === 0) return;

// Collect all kana-like content from remaining cells
let letters = '';
cells.each((i, cell) => {
  if (i === 0) return;
  const txt = normalizeKana($(cell).text());
  letters += onlyHiragana(txt);
});

letters = [...new Set(letters)].join(''); // deduplicate chars
if (letters.length < 2) return;           // skip rows with too few kana

const key = `${nameCand}:${letters}`;
if (seen.has(key)) return;
seen.add(key);

units.push({ name: nameCand, letters });
```

});

// Fallback: also try definition-list style markup (dl/dt/dd)
$(‘dl’).each((_, dl) => {
const name = $(dl).find(‘dt’).first().text().trim();
if (!name) return;

```
let letters = '';
$(dl).find('dd').each((_, dd) => {
  const txt = normalizeKana($(dd).text());
  letters += onlyHiragana(txt);
});

letters = [...new Set(letters)].join('');
if (letters.length < 2) return;

const key = `${name}:${letters}`;
if (seen.has(key)) return;
seen.add(key);

units.push({ name, letters });
```

});

if (units.length === 0) {
console.warn(‘⚠  No units parsed — the page structure may have changed.’);
console.warn(’    Check the selectors in scrape-units.js.’);
// Write an empty-but-valid file so the app still loads
}

const js =
`// Auto-generated by scrape-units.js — do not edit manually.\n` +
`// Last updated: ${new Date().toISOString()}\n` +
`// Source: ${URL}\n\n` +
`var unitDatabase = ${JSON.stringify(units, null, 2)};\n`;

fs.writeFileSync(OUT, js, ‘utf8’);
console.log(`✓ Wrote ${units.length} units to ${OUT}`);
}

main().catch(err => {
console.error(err);
process.exit(1);
});